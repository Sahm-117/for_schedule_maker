VITE_DATA_PROVIDER=supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# PWA Push Notifications — generate with: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here

# PostHog analytics (optional): the project's public key. Leave unset to send nothing.
# POSTHOG_KEY=phc_your_project_key
# POSTHOG_HOST=https://us.i.posthog.com   (VITE_POSTHOG_KEY / VITE_POSTHOG_HOST also work)

# Optional backend mode (future)
# VITE_DATA_PROVIDER=backend
# VITE_API_URL=https://your-backend-url.com/api
